OPENAQ_API_KEY=<your_api_key_here>
DAGSHUB_TOKEN=<your_api_key_here>
AQICN_TOKEN=<your_api_key_here>
MAILTRAP_USERNAME=<your_MailTrap_username_here>
MAILTRAP_PASSWORD=<your_MailTrap_password_here>
AIRFLOW_ALERT_EMAIL=<your_email_here>
MLFLOW_TRACKING_URI=http://mlflow:5000
FASTAPI_URL=http://fastapi:8000
AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=admin # Change this to set a custom Airflow username
AIRFLOW_PASSWORD=admin # Change this to set a custom Airflow password
RETRAIN_POOL_SLOTS=1 # Number of parallel retraining tasks allowed (adjust based on your resources)
AIRFLOW_PARALLELISM=4 # Total number of parallel tasks across all DAGs (adjust based on your resources)
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=4 # Max active tasks per DAG (adjust based on your DAG's needs)
AIRFLOW_SCHEDULER_MEM=4g # Memory allocated to Airflow Scheduler (adjust based on your resources)
AIRFLOW_SCHEDULER_CPUS=4.0 # CPU cores allocated to Airflow Scheduler (adjust based on your resources)
FASTAPI_MEM=1g # Memory allocated to FastAPI service (adjust based on your resources)
FASTAPI_CPUS=2.0 # CPU cores allocated to FastAPI service (adjust based on your resources)
DRIFT_SEASONAL=false # Set to true if you want to enable seasonal drift detection (e.g., comparing current month with same month in previous year)
AIRFLOW_UID=<your_airflow_uid_here> # Set this to the UID of the user running Airflow on your host machine to avoid permission issues with mounted volumes (e.g., 1000 for most Linux systems)